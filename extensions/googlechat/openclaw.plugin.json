{
  "id": "googlechat",
  "channels": ["googlechat"],
  "channelEnvVars": {
    "googlechat": ["GOOGLE_CHAT_SERVICE_ACCOUNT", "GOOGLE_CHAT_SERVICE_ACCOUNT_FILE"]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "ingestionMode": {
        "type": "string",
        "enum": ["webhook", "pubsub"],
        "default": "webhook"
      },
      "pubsub": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": { "type": "string" },
          "topicId": { "type": "string" },
          "subscriptionId": { "type": "string" }
        }
      },
      "clientEmail": {
        "type": "string"
      }
    }
  }
}
